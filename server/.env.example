[TEMPLATE]
# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# M-Pesa (Safaricom Daraja)
# Get credentials from: https://developer.safaricom.co.ke
# IMPORTANT: Switch MPESA_ENV to 'production' for real payments
MPESA_ENV=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-railway-url.up.railway.app/api/deposits/mpesa/callback
MPESA_TIMEOUT=30
